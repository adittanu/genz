{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "genz-chrome"
          },
          "size": {
            "px": 42
          },
          "background": {
            "image": "backgrounds/ocean-header.png",
            "fit": "cover"
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "genz-spaces"
              },
              "size": {
                "px": 0
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "genz-agents"
              },
              "size": {
                "weight": 1
              }
            }
          ],
          "resizable": false
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "genz-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 42
          }
        }
      ],
      "size": {
        "px": 342
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "genz-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "hover",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "quota",
                      "type": "block",
                      "content": {
                        "mod": "quota"
                      }
                    }
                  ],
                  "active": "changes"
                }
              ],
              "size": {
                "px": 482
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "pokemon-agents",
          "type": "block",
          "content": {
            "mod": "pokemon-agents"
          },
          "size": {
            "px": 112
          },
          "min": 26,
          "max": 240
        },
        {
          "id": "projects",
          "type": "block",
          "content": {
            "mod": "projects",
            "props": {
              "view": "host"
            }
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    36
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/genz-preview.svg"
}
