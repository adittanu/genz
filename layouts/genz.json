{
  "id": "root",
  "preview": "layouts/genz-preview.svg",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": { "mod": "genz-chrome" },
          "size": { "px": 42 },
          "window_drag": true,
          "background": { "image": "backgrounds/ocean-header.png", "fit": "cover" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": { "mod": "genz-spaces" },
              "size": { "weight": 0.67 },
              "min": 34
            },
            {
              "id": "agents",
              "type": "block",
              "content": { "mod": "genz-agents" },
              "size": { "weight": 1.73 },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": { "mod": "genz-chrome", "props": { "footer": true } },
          "size": { "px": 68 }
        }
      ],
      "size": { "px": 342 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": { "mod": "genz-tabs" },
          "size": { "px": 42 },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": { "mod": "pane" },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                    { "id": "quota", "type": "block", "content": { "mod": "quota" } }
                  ],
                  "active": "changes"
                }
              ],
              "size": { "px": 482 },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": { "mod": "workspace-status" },
          "size": { "px": 28 }
        },
        {
          "id": "projects",
          "type": "block",
          "content": { "mod": "projects", "props": { "view": "host" } },
          "size": { "px": 0 }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16]
}
